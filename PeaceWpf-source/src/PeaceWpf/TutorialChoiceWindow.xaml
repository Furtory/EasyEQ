<ui:FluentWindow x:Class="PeaceWpf.TutorialChoiceWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="教程 · 选一个"
                 Width="500"
                 Height="520"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24">
        <TextBlock Text="想学哪一段？"
                   FontSize="20"
                   FontWeight="SemiBold" />
        <TextBlock Text="选一个，接着用气泡带你看功能位置。"
                   FontSize="12"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,6,0,18" />

        <!-- 卡片区与底部按钮共用一个宽度：按钮自动跟随两张卡片的总宽，不写死数字 -->
        <Grid HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <!-- 基础课：预设EQ 的五个频段 -->
                <Button Style="{StaticResource CourseCard}"
                        AutomationProperties.AutomationId="TutorialBasicChoiceButton"
                        ToolTip="从零开始：套用预设EQ、用自动EQ测量、保存设置"
                        Click="OnBasic">
                    <StackPanel Margin="16" VerticalAlignment="Center">
                        <Border Width="104"
                                Height="104"
                                CornerRadius="52"
                                HorizontalAlignment="Center"
                                Background="#141F6FEB"
                                BorderBrush="#334CC2FF"
                                BorderThickness="1">
                            <Viewbox Width="78" Height="78">
                                <Canvas Width="100" Height="100">
                                    <Rectangle Canvas.Left="10" Canvas.Top="37" Width="10" Height="26"
                                               RadiusX="5" RadiusY="5" Fill="#FF4CC2FF" />
                                    <Rectangle Canvas.Left="28" Canvas.Top="26" Width="10" Height="48"
                                               RadiusX="5" RadiusY="5" Fill="#994CC2FF" />
                                    <Rectangle Canvas.Left="46" Canvas.Top="33" Width="10" Height="34"
                                               RadiusX="5" RadiusY="5" Fill="#FF4CC2FF" />
                                    <Rectangle Canvas.Left="64" Canvas.Top="19" Width="10" Height="62"
                                               RadiusX="5" RadiusY="5" Fill="#994CC2FF" />
                                    <Rectangle Canvas.Left="82" Canvas.Top="29" Width="10" Height="42"
                                               RadiusX="5" RadiusY="5" Fill="#FF4CC2FF" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <TextBlock Text="基础课"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0" />
                        <TextBlock Text="预设EQ · 自动EQ · 保存"
                                   FontSize="11"
                                   Opacity="0.65"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Button>

                <!-- 进阶课：一条自己画的曲线 -->
                <Button Style="{StaticResource CourseCard}"
                        Margin="16,0,0,0"
                        AutomationProperties.AutomationId="TutorialAdvancedChoiceButton"
                        ToolTip="自己动手：切换曲线、亲手画曲线、对比听效果"
                        Click="OnAdvanced">
                    <StackPanel Margin="16" VerticalAlignment="Center">
                        <Border Width="104"
                                Height="104"
                                CornerRadius="52"
                                HorizontalAlignment="Center"
                                Background="#141F6FEB"
                                BorderBrush="#334CC2FF"
                                BorderThickness="1">
                            <Viewbox Width="78" Height="78">
                                <Canvas Width="100" Height="100">
                                    <Line X1="8" Y1="84" X2="92" Y2="84"
                                          Stroke="#33FFFFFF"
                                          StrokeThickness="1" />
                                    <Path Data="M 10,64 C 24,64 28,28 46,28 C 62,28 64,64 82,64 C 88,64 91,48 94,36"
                                          Stroke="#FF4CC2FF"
                                          StrokeThickness="5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                    <Ellipse Canvas.Left="3" Canvas.Top="57" Width="14" Height="14"
                                             Fill="White" Stroke="#FF1A1A1A" StrokeThickness="3" />
                                    <Ellipse Canvas.Left="39" Canvas.Top="21" Width="14" Height="14"
                                             Fill="White" Stroke="#FF1A1A1A" StrokeThickness="3" />
                                    <Ellipse Canvas.Left="75" Canvas.Top="57" Width="14" Height="14"
                                             Fill="White" Stroke="#FF1A1A1A" StrokeThickness="3" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <TextBlock Text="进阶课"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0" />
                        <TextBlock Text="进入低音 · 自定义曲线 · 叠加试听 · 自动切换"
                                   FontSize="11"
                                   Opacity="0.65"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button Grid.Row="1"
                    Content="取消"
                    AutomationProperties.AutomationId="TutorialChoiceCancelButton"
                    Click="OnCancel"
                    HorizontalAlignment="Stretch"
                    Margin="0,16,0,0"
                    Padding="16,6"
                    IsCancel="True" />
        </Grid>
    </StackPanel>
</ui:FluentWindow>
