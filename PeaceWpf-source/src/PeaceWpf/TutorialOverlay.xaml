<UserControl x:Class="PeaceWpf.TutorialOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Focusable="True"
             PreviewKeyDown="OnPreviewKeyDown"
             SizeChanged="OnOverlaySizeChanged">

    <UserControl.Resources>
        <Style x:Key="TutorialButton" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="#FF2C2C2C" />
            <Setter Property="Foreground" Value="#FFDCDCDC" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" />
                            <Border x:Name="Overlay" CornerRadius="6" Background="Transparent" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root"
          Background="#01000000"
          ClipToBounds="True">
        <Canvas x:Name="Layer">
            <Path x:Name="DimPath"
                  Fill="#99000000"
                  IsHitTestVisible="False" />

            <!-- 进阶课的曲线演示：画在遮罩上，不碰真实曲线 -->
            <Canvas x:Name="CurveDemoLayer"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <Border x:Name="DemoPanel"
                        Background="#FF181818"
                        BorderBrush="#334CC2FF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                    <TextBlock x:Name="DemoPanelTitle"
                               Text="演示曲线"
                               FontSize="10"
                               Foreground="#66FFFFFF"
                               Margin="8,6,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top" />
                </Border>
                <Canvas x:Name="DemoGrid" IsHitTestVisible="False" />
                <Path x:Name="DemoFlatLine"
                      Stroke="#66FFFFFF"
                      StrokeThickness="1"
                      StrokeDashArray="4,4" />
                <Path x:Name="DemoMeasuredPath"
                      Stroke="#FFB0B0B0"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
                <Path x:Name="DemoCurvePath"
                      Stroke="#FF4CC2FF"
                      StrokeThickness="2.4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
                <Canvas x:Name="DemoDots" />
                <!-- 自动EQ 演示：实测 / 低音补偿 / 矫正起点竖线 -->
                <Path x:Name="DemoBassPath"
                      Stroke="#FF66D97A"
                      StrokeThickness="1.5"
                      StrokeDashArray="2,2"
                      Visibility="Collapsed" />
                <Line x:Name="DemoCrossover"
                      Stroke="#FFFFD166"
                      StrokeThickness="1.6"
                      StrokeDashArray="5,3"
                      IsHitTestVisible="False"
                      Visibility="Collapsed" />
                <TextBlock x:Name="DemoCrossoverLabel"
                           FontSize="10"
                           Foreground="#FFFFD166"
                           IsHitTestVisible="False"
                           Visibility="Collapsed" />
                <Border x:Name="DemoDropdown"
                        Background="#F21C1C1C"
                        BorderBrush="#994CC2FF"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="2"
                        Visibility="Collapsed">
                    <StackPanel x:Name="DemoDropdownItems" />
                </Border>
                <Border x:Name="DemoBadge"
                        Background="#F21A1A1A"
                        BorderBrush="#664CC2FF"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,4"
                        Visibility="Collapsed">
                    <TextBlock x:Name="DemoBadgeText"
                               FontSize="11"
                               Foreground="#FFDCDCDC" />
                </Border>
            </Canvas>

            <Border x:Name="Spotlight"
                    BorderBrush="#FF4CC2FF"
                    BorderThickness="1.5"
                    CornerRadius="10"
                    Background="Transparent"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="0"
                                      Color="#FF4CC2FF"
                                      Opacity="0.75" />
                </Border.Effect>
            </Border>

            <Line x:Name="LeaderLine"
                  Stroke="#884CC2FF"
                  StrokeThickness="1.2"
                  IsHitTestVisible="False"
                  Visibility="Collapsed" />

            <!-- 点左右 / 低音后，模拟图表进入编辑态 -->
            <Border x:Name="GraphEditGlow"
                    Background="Transparent"
                    BorderBrush="#CC4CC2FF"
                    BorderThickness="2"
                    CornerRadius="10"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Visibility="Collapsed" />

            <!-- 被“点中”的模式按钮也变蓝 -->
            <Border x:Name="ModeIconGlow"
                    Background="#CC102A3D"
                    BorderBrush="#FF4CC2FF"
                    BorderThickness="1.5"
                    CornerRadius="7"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Visibility="Collapsed">
                <TextBlock x:Name="ModeIconText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FF4CC2FF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <Border x:Name="Bubble"
                    Width="340"
                    Background="#F21A1A1A"
                    BorderBrush="#664CC2FF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="0"
                                      Color="Black"
                                      Opacity="0.85" />
                </Border.Effect>

                <StackPanel>
                    <TextBlock x:Name="StepLabel"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="#FF4CC2FF" />
                    <TextBlock x:Name="TitleText"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="BodyText"
                               FontSize="12.5"
                               LineHeight="19"
                               LineStackingStrategy="BlockLineHeight"
                               TextWrapping="Wrap"
                               Opacity="0.9"
                               Margin="0,6,0,0" />
                    <TextBlock x:Name="AudioStatus"
                               AutomationProperties.AutomationId="TutorialAudioStatus"
                               FontSize="11"
                               Foreground="#FFD08A2B"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,8,0,0" />
                    <TextBlock x:Name="DemoStatus"
                               AutomationProperties.AutomationId="TutorialDemoStatus"
                               FontSize="11"
                               Foreground="#FF4CC2FF"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,8,0,0" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="AudioButton"
                                Grid.Column="0"
                                Style="{StaticResource TutorialButton}"
                                AutomationProperties.AutomationId="TutorialAudioButton"
                                Content="播放对比"
                                Background="Transparent"
                                BorderBrush="#664CC2FF"
                                Foreground="#FF4CC2FF"
                                Visibility="Collapsed"
                                Click="OnAudio" />
                        <Button x:Name="DemoButton"
                                Grid.Column="0"
                                Style="{StaticResource TutorialButton}"
                                AutomationProperties.AutomationId="TutorialDemoButton"
                                Content="重播演示"
                                Background="Transparent"
                                BorderBrush="#664CC2FF"
                                Foreground="#FF4CC2FF"
                                Visibility="Collapsed"
                                Click="OnReplayDemo" />
                        <Button x:Name="SkipButton"
                                Grid.Column="2"
                                Style="{StaticResource TutorialButton}"
                                AutomationProperties.AutomationId="TutorialSkipButton"
                                Content="跳过"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Foreground="#FFCFCFCF"
                                Click="OnSkip" />
                        <Button x:Name="NextButton"
                                Grid.Column="3"
                                Style="{StaticResource TutorialButton}"
                                AutomationProperties.AutomationId="TutorialNextButton"
                                Content="下一步"
                                Background="#FF1F6FEB"
                                BorderBrush="#FF4CC2FF"
                                Foreground="White"
                                Margin="8,0,0,0"
                                Click="OnNext" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid x:Name="CursorDot"
                  Width="26"
                  Height="26"
                  IsHitTestVisible="False"
                  Visibility="Collapsed"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="CursorTransform" />
                </Grid.RenderTransform>

                <Ellipse x:Name="ClickPulse"
                         Width="26"
                         Height="26"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Stroke="#FF4CC2FF"
                         StrokeThickness="2"
                         Opacity="0"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="PulseScale" ScaleX="0.5" ScaleY="0.5" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse Width="26"
                         Height="26"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Fill="#22FFFFFF"
                         Stroke="White"
                         StrokeThickness="1.5" />
                <Ellipse Width="5"
                         Height="5"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Fill="White" />
            </Grid>

            <!-- 跟着圆形光标走的鼠标示意：左键 / 右键 / 滚轮按当前动作高亮 -->
            <Grid x:Name="DemoMouse"
                  Width="28"
                  Height="42"
                  IsHitTestVisible="False"
                  Visibility="Collapsed"
                  RenderTransformOrigin="0,0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="DemoMouseTransform" />
                </Grid.RenderTransform>

                <Border Background="#F21A1A1A"
                        BorderBrush="#FF4CC2FF"
                        BorderThickness="1.2"
                        CornerRadius="13">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12"
                                          ShadowDepth="0"
                                          Color="#FF4CC2FF"
                                          Opacity="0.55" />
                    </Border.Effect>
                </Border>

                <Border x:Name="MouseLeftButton"
                        Width="11"
                        Height="17"
                        Margin="3,3,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="#33FFFFFF"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="0.8"
                        CornerRadius="5,0,0,0" />
                <Border x:Name="MouseRightButton"
                        Width="11"
                        Height="17"
                        Margin="0,3,3,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#33FFFFFF"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="0.8"
                        CornerRadius="0,5,0,0" />
                <Border x:Name="MouseWheelMark"
                        Width="4"
                        Height="9"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="#66FFFFFF"
                        CornerRadius="2" />
            </Grid>

            <Border x:Name="DemoKeyCap"
                    Background="Transparent"
                    BorderThickness="0"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F21A1A1A"
                            BorderBrush="#FF4CC2FF"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="7,3">
                        <TextBlock Text="Ctrl"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#FF4CC2FF" />
                    </Border>
                    <TextBlock Text="+"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#FF4CC2FF"
                               VerticalAlignment="Center"
                               Margin="4,0" />
                    <Border Background="#F21A1A1A"
                            BorderBrush="#FF4CC2FF"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="7,3">
                        <TextBlock Text="Z"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#FF4CC2FF" />
                    </Border>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
