<Window x:Class="PeaceWpf.CloseBehaviorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭窗口"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- 和 DialogWindow 同一套外观：外面留 18 的边给阴影，圆角靠 Border 画 -->
    <Border Margin="18"
            CornerRadius="12"
            Background="#FF1A1A1A"
            BorderBrush="#33FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.85" Color="Black" />
        </Border.Effect>

        <StackPanel Margin="22,18,22,18">
            <TextBlock FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Text="关闭窗口" />

            <TextBlock Margin="0,10,0,0"
                       FontSize="12.5"
                       LineHeight="19"
                       Foreground="White"
                       TextWrapping="Wrap"
                       Text="关闭后想怎么做？以后可以在「设置 → 常规设置 → 退出行为」里改。" />

            <RadioButton x:Name="MinimizeRadio"
                         GroupName="CloseBehavior"
                         Margin="0,18,0,0"
                         IsChecked="True">
                <StackPanel>
                    <TextBlock FontSize="13"
                               Foreground="White"
                               Text="最小化到托盘" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="11"
                               Opacity="0.55"
                               Foreground="White"
                               TextWrapping="Wrap"
                               Text="程序继续在后台运行，左键点托盘图标就回来。" />
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="ExitRadio"
                         GroupName="CloseBehavior"
                         Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock FontSize="13"
                               Foreground="White"
                               Text="退出软件" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="11"
                               Opacity="0.55"
                               Foreground="White"
                               TextWrapping="Wrap"
                               Text="关掉窗口，程序彻底退出。" />
                </StackPanel>
            </RadioButton>

            <TextBlock Margin="0,18,0,0"
                       FontSize="11"
                       Opacity="0.45"
                       Foreground="White"
                       TextWrapping="Wrap"
                       Text="「记住选择」会写进设置，下次不再问；按 Esc 就不关了。" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button x:Name="OnceButton"
                        Content="仅这一次"
                        IsDefault="True"
                        Padding="18,6"
                        MinWidth="78"
                        FontSize="12"
                        Click="OnOnce" />
                <Button x:Name="RememberButton"
                        Content="记住选择"
                        Padding="18,6"
                        MinWidth="78"
                        FontSize="12"
                        Margin="8,0,0,0"
                        Click="OnRemember" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
