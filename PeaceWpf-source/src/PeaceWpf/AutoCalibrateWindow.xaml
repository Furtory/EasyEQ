<ui:FluentWindow x:Class="PeaceWpf.AutoCalibrateWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="自动EQ · 扫频校准"
                 Width="900"
                 Height="660"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 目标 + 麦克风 + 次数 + 开始 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock x:Name="TargetText"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="TargetHint"
                           FontSize="12"
                           Opacity="0.65"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="麦克风" FontSize="11" Opacity="0.6" />
                <ComboBox x:Name="DeviceBox"
                          Width="230"
                          Margin="0,3,0,0"
                          FontSize="12"
                          AutomationProperties.AutomationId="CalibrateDeviceBox"
                          ToolTip="用哪个麦克风听回扫频声；没有专业测量麦时，耳机自带的也能用，只是高低频会不太准"
                          DisplayMemberPath="Name" />
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="速度" FontSize="11" Opacity="0.6" />
                <ComboBox x:Name="SpeedBox"
                          Width="104"
                          Margin="0,3,0,0"
                          FontSize="12"
                          AutomationProperties.AutomationId="CalibrateSpeedBox"
                          SelectionChanged="OnSpeedChanged"
                          ToolTip="快速：扫 1 遍，约 30 秒；标准：扫 2 遍，约 2 分钟；更准：扫 3 遍，约 5 分钟。手上有结果时换档会先问一句，确认后清空" />
            </StackPanel>

            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                <Button x:Name="StartButton"
                        Content="开始测量"
                        AutomationProperties.AutomationId="CalibrateStartButton"
                        Click="OnMeasureClick"
                        Padding="18,8"
                        MinWidth="112"
                        FontSize="13"
                        ToolTip="测完会变成「继续测量」：可以先套用结果，再测一遍看看还差多少。测量中再点一下是停止。" />
                <Button x:Name="PreviewButton"
                        Content="试听扫频"
                        AutomationProperties.AutomationId="CalibratePreviewButton"
                        Click="OnPreviewSweep"
                        Padding="18,6"
                        MinWidth="112"
                        Margin="0,6,0,0"
                        FontSize="12"
                        ToolTip="放一遍 5 秒的扫频声（20 Hz 慢慢升到 20 kHz）。听到的就是当前这套 EQ 处理后的效果，测量前后都能用。" />
            </StackPanel>
        </Grid>

        <!-- 进度与电平 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="2"
                       x:Name="RemainingText"
                       FontSize="11"
                       Opacity="0.7"
                       Margin="0,0,0,6"
                       Text="" />

            <ProgressBar Grid.Row="1"
                         x:Name="Progress"
                         Height="6"
                         VerticalAlignment="Center"
                         Minimum="0"
                         Maximum="100"
                         Value="0" />

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="麦克风电平" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                <TextBlock x:Name="LevelText"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"
                           Text="—" />
            </StackPanel>
        </Grid>

        <!-- 曲线 -->
        <Border Grid.Row="2"
                Background="#141414"
                BorderBrush="#33808080"
                BorderThickness="1"
                CornerRadius="6">
            <Canvas x:Name="Plot"
                    AutomationProperties.AutomationId="CalibratePlot"
                    Background="#141414"
                    ClipToBounds="True"
                    SizeChanged="OnPlotSizeChanged"
                    MouseLeftButtonDown="OnPlotMouseDown"
                    MouseMove="OnPlotMouseMove"
                    MouseLeftButtonUp="OnPlotMouseUp"
                    MouseLeave="OnPlotMouseLeave" />
        </Border>

        <!-- 图例 -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,10,0,0">
            <Rectangle Width="14" Height="3" Fill="#909090" VerticalAlignment="Center" />
            <TextBlock Text="实测" FontSize="11" Opacity="0.7" Margin="5,0,14,0" />
            <Rectangle Width="14" Height="3" Fill="#4CC2FF" VerticalAlignment="Center" />
            <TextBlock Text="目标" FontSize="11" Opacity="0.7" Margin="5,0,14,0" />
            <Rectangle Width="14" Height="3" Fill="#4CC2FF" VerticalAlignment="Center" />
            <TextBlock Text="左右 EQ" FontSize="11" Opacity="0.7" Margin="5,0,14,0" />
            <Rectangle Width="14" Height="3" Fill="#A78BFA" VerticalAlignment="Center" />
            <TextBlock Text="低频矫正（低音层）" FontSize="11" Opacity="0.7" Margin="5,0,14,0" />
            <Rectangle Width="14" Height="3" Fill="#6FD3C7" VerticalAlignment="Center" />
            <TextBlock Text="麦克风" FontSize="11" Opacity="0.7" Margin="5,0,14,0" />
            <Line Width="14" Height="3"
                  X1="0" X2="14" Y1="1.5" Y2="1.5"
                  Stroke="#FF5A5A"
                  StrokeThickness="1"
                  StrokeDashArray="2,2"
                  VerticalAlignment="Center" />
            <TextBlock Text="预增益" FontSize="11" Opacity="0.7" Margin="5,0,0,0" />
        </StackPanel>

        <!-- 底部：左边是提升上限刻度，右边是按钮 -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <!-- 麦克风矫正曲线：放滑杆左边，先纠正「尺子」，再谈贴合 -->
                <Button x:Name="MicCalibrationButton"
                        Content="导入麦克风矫正曲线"
                        AutomationProperties.AutomationId="CalibrateMicCalibrationButton"
                        Click="OnImportMicCalibration"
                        PreviewMouseRightButtonUp="OnClearMicCalibration"
                        Padding="10,5"
                        Margin="0,0,12,0"
                        FontSize="11"
                        VerticalAlignment="Center"
                        ToolTip="把你的测量麦克风的频响曲线导进来，实测会先扣掉麦克风自己的偏差，拟合出来的 EQ 才是喇叭的。两列文本就行：频率（Hz，可写 1k）、偏差（dB）。导入后按钮变蓝，右键清除。" />

                <Grid Width="320" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="贴合目标"
                               FontSize="11"
                               Opacity="0.6"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                    <Slider Grid.Column="1"
                            x:Name="BoostSlider"
                            AutomationProperties.AutomationId="CalibrateBoostSlider"
                            Minimum="0"
                            Maximum="100"
                            TickFrequency="10"
                            IsSnapToTickEnabled="True"
                            SmallChange="10"
                            LargeChange="20"
                            Value="0"
                            ToolTip="测量中不能改；前 50% 补整体音量，后 50% 放开提升并允许削波"
                            PreviewMouseLeftButtonDown="OnBoostDragStart"
                            PreviewMouseMove="OnBoostDragMove"
                            PreviewMouseLeftButtonUp="OnBoostDragUp"
                            MouseLeave="OnBoostDragLeave" />

                    <TextBlock Grid.Column="2"
                               Text="保证音量"
                               FontSize="11"
                               Opacity="0.6"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </Grid>
            </StackPanel>

            <Popup x:Name="BoostTip"
                   Placement="Relative"
                   PlacementTarget="{Binding ElementName=BoostSlider}"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   IsHitTestVisible="False">
                <Border Background="#E6202020"
                        CornerRadius="4"
                        Padding="7,3">
                    <TextBlock x:Name="BoostTipText"
                               FontSize="11"
                               Foreground="White" />
                </Border>
            </Popup>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">
                <Button x:Name="ApplyButton"
                        Content="套用矫正EQ"
                        AutomationProperties.AutomationId="CalibrateApplyButton"
                        Click="OnApply"
                        Padding="16,7"
                        FontSize="13"
                        IsEnabled="False"
                        ToolTip="把主层校正写进「左右」层，同时按当前实测生成 20–100 Hz 低频矫正、整层替换「低音」层；预增益只按左右层算，低频提升不参与。两层都是未保存的改动，主窗口可以撤回" />
                <Button Content="关闭"
                        AutomationProperties.AutomationId="CalibrateCloseButton"
                        Click="OnClose"
                        Padding="14,7"
                        Margin="8,0,0,0"
                        FontSize="13" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
