<ui:FluentWindow x:Class="PeaceWpf.AutoEqWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:ctrl="clr-namespace:PeaceWpf.Controls"
                 Title="预设EQ · 按耳机型号套用校正曲线"
                 Width="1040"
                 Height="660"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ctrl:BrandLogoConverter x:Key="BrandLogo" />
        <!-- 矢量标记画 Path，位图字标放 Image；两种都保持左对齐、顶部对齐 -->
        <ctrl:BrandIconTemplateSelector x:Key="BrandIconSelector">
            <ctrl:BrandIconTemplateSelector.Vector>
                <DataTemplate>
                    <Path Width="15" Height="15" Stretch="Uniform" Fill="#C8FFFFFF" Data="{Binding}" />
                </DataTemplate>
            </ctrl:BrandIconTemplateSelector.Vector>
            <ctrl:BrandIconTemplateSelector.Bitmap>
                <DataTemplate>
                    <Image Source="{Binding}" Height="14" MaxWidth="82" Stretch="Uniform" Opacity="0.92" />
                </DataTemplate>
            </ctrl:BrandIconTemplateSelector.Bitmap>
        </ctrl:BrandIconTemplateSelector>
    </ui:FluentWindow.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 选库、搜型号、挑形态 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="数据库"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       FontSize="12"
                       Opacity="0.7" />
            <ComboBox x:Name="DatabaseBox"
                      Grid.Column="1"
                      Margin="0,0,14,0"
                      FontSize="12"
                      AutomationProperties.AutomationId="AutoEqDatabaseBox"
                      SelectionChanged="OnDatabaseChanged"
                      ToolTip="选择校正数据的来源，四个库选一个就行" />

            <TextBlock Grid.Column="2"
                       Text="搜型号"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       FontSize="12"
                       Opacity="0.7" />
            <TextBox x:Name="SearchBox"
                     Grid.Column="3"
                     Margin="0,0,14,0"
                     Padding="6,4"
                     FontSize="12"
                     AutomationProperties.AutomationId="AutoEqSearchBox"
                     TextChanged="OnSearchTextChanged"
                     ToolTip="输入品牌或型号，多个词用空格分开，会一起参与搜索" />

            <TextBlock Grid.Column="4"
                       Text="形态"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       FontSize="12"
                       Opacity="0.7" />
            <ComboBox x:Name="TypeBox"
                      Grid.Column="5"
                      FontSize="12"
                      AutomationProperties.AutomationId="AutoEqTypeBox"
                      SelectionChanged="OnTypeChanged"
                      ToolTip="参数 EQ 最准；固定频带 EQ 只有 10 段；图形 EQ 不能直接套用" />
        </Grid>

        <!-- 左边型号，右边 EqualizerAPO 命令预览 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderThickness="1"
                    CornerRadius="6"
                    BorderBrush="#33808080">
                <ListBox x:Name="DeviceList"
                         BorderThickness="0"
                         FontSize="12"
                         AutomationProperties.AutomationId="AutoEqDeviceList"
                         SelectionChanged="OnDeviceChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 品牌图标：认得出才显示，认不出这一列宽度收成 0，文字照常顶格 -->
                                <ContentControl Grid.Column="0"
                                                Margin="0,1,6,0"
                                                VerticalAlignment="Top"
                                                Content="{Binding Converter={StaticResource BrandLogo}}"
                                                ContentTemplateSelector="{StaticResource BrandIconSelector}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="11"
                                               Opacity="0.6"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent" />

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top"
                           x:Name="SummaryText"
                           FontSize="12"
                           Opacity="0.75"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6" />

                <Expander DockPanel.Dock="Bottom"
                          x:Name="CommandsExpander"
                          Header="看命令（EqualizerAPO）"
                          IsExpanded="False"
                          FontSize="12"
                          Margin="0,8,0,0">
                    <TextBox x:Name="PreviewBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="8"
                             Height="150"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </Expander>

                <Border BorderThickness="1"
                        CornerRadius="6"
                        BorderBrush="#33808080"
                        MinHeight="180"
                        ToolTip="这条校正曲线的样子：横向是人耳能听到的频率，纵向是每个频段调大或调小的量">
                    <ctrl:EqCurvePreview x:Name="PreviewGraph"
                                         AutomationProperties.AutomationId="AutoEqPreviewGraph" />
                </Border>
            </DockPanel>
        </Grid>

        <!-- 底部：状态 + 三个按钮 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       AutomationProperties.AutomationId="AutoEqStatus"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Opacity="0.75"
                       TextTrimming="CharacterEllipsis"
                       ToolTipService.ShowDuration="60000" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CreateButton"
                        Content="创建到新曲线"
                        AutomationProperties.AutomationId="AutoEqCreateButton"
                        Click="OnCreate"
                        Padding="12,6"
                        FontSize="12"
                        IsEnabled="False"
                        ToolTip="把这份校正另存成一条新预设，不动你现在正在用的曲线" />
                <Button x:Name="ApplyButton"
                        Content="应用到「左右」层"
                        AutomationProperties.AutomationId="AutoEqApplyButton"
                        Click="OnApply"
                        Padding="16,6"
                        Margin="8,0,0,0"
                        FontSize="12"
                        IsEnabled="False"
                        ToolTip="用这份校正替换左右曲线，并顺手调好整体音量；在主窗口可以撤回" />
                <Button Content="关闭"
                        AutomationProperties.AutomationId="AutoEqCloseButton"
                        Click="OnClose"
                        Padding="12,6"
                        Margin="8,0,0,0"
                        FontSize="12" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
