<ui:FluentWindow x:Class="PeaceWpf.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="设置"
                 Width="960"
                 Height="640"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 状态灯：红 = 没找到，橙 = 找到没接上，绿 = 已接上 -->
        <Style x:Key="ApoStatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Text" Value="未检测到，先装一下" />
            <Setter Property="Foreground" Value="#FFE85A5A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsApoFound}" Value="True">
                    <Setter Property="Text" Value="已检测到，还没接上" />
                    <Setter Property="Foreground" Value="#FFD08A2B" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsApoFound}" Value="True" />
                        <Condition Binding="{Binding IsApoIncluded}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Text" Value="已接上，改动立即生效" />
                    <Setter Property="Foreground" Value="#FF55D98A" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ApoStatusDot" TargetType="TextBlock">
            <Setter Property="Text" Value="●" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#FFE85A5A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsApoFound}" Value="True">
                    <Setter Property="Foreground" Value="#FFD08A2B" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsApoFound}" Value="True" />
                        <Condition Binding="{Binding IsApoIncluded}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#FF55D98A" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏。这个窗口没有系统标题栏按钮，右上角自己画一个关闭 -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="设置"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="控制台：左栏管运行环境，中栏管使用习惯，右栏是软件本身。"
                           FontSize="12"
                           Opacity="0.6"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Button Content="&#xE711;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="12"
                    Width="36"
                    Height="32"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip="关闭"
                    Click="OnClose" />
        </Grid>

        <!-- 三块面板 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ 1. 运行环境 ============ -->
            <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Margin="0,0,7,0">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE9F5;"
                                       FontSize="16"
                                       Foreground="#FF4CC2FF"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="运行环境"
                                       Style="{StaticResource PanelTitle}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Height="1" Background="#FF2E2E2E" Margin="0,14,0,14" />

                        <!-- ① 安装状态 + 版本号 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource ApoStatusDot}" />
                            <TextBlock x:Name="ApoInstallText"
                                       FontSize="12"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="未检测到 EqualizerAPO" />
                        </StackPanel>

                        <!-- ② 安装按钮：与「重新连接」同宽同对齐 -->
                        <Button Content="安装 EqualizerAPO"
                                Click="OnInstallApo"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Margin="0,0,0,14"
                                ToolTip="自动下载官方安装包并拉起安装程序" />

                        <!-- ③ 连接状态 -->
                        <TextBlock Text="连接状态" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource ApoStatusDot}" />
                            <TextBlock Style="{StaticResource ApoStatusText}" Margin="6,0,0,0" />
                        </StackPanel>
                        <!-- 环境：静态事实，回答「为什么保存了没效果」 -->
                        <TextBlock Text="{Binding EnvironmentSummary}"
                                   Style="{StaticResource Hint}"
                                   Margin="0,0,0,10" />

                        <!-- ④ 重新连接：紧接状态行，与下面调试框同宽，文字居中 -->
                        <Button Content="重新连接"
                                Click="OnRecheckApo"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Margin="0,0,0,12" />

                        <!-- 调试信息：曲线 / 动作 / 警告 / 错误 -->
                        <TextBlock Text="调试信息" Style="{StaticResource SectionLabel}" />
                        <Border Background="#0AFFFFFF"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,12"
                                AutomationProperties.AutomationId="SettingsStatus">
                            <StackPanel>
                                <TextBlock Text="曲线"
                                           FontSize="11"
                                           Opacity="0.5"
                                           Margin="0,0,0,2" />
                                <TextBlock Text="{Binding CurveSummary}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="动作"
                                           FontSize="11"
                                           Opacity="0.5"
                                           Margin="0,0,0,2" />
                                <TextBlock Text="{Binding ActionsSummary}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           MaxHeight="70"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="警告"
                                           FontSize="11"
                                           Opacity="0.5"
                                           Margin="0,0,0,2" />
                                <TextBlock Text="{Binding WarningsSummary}"
                                           FontSize="11"
                                           Foreground="#FFD08A2B"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="错误"
                                           FontSize="11"
                                           Opacity="0.5"
                                           Margin="0,0,0,2" />
                                <TextBlock Text="{Binding ErrorsSummary}"
                                           FontSize="11"
                                           Foreground="#FFE85A5A"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 复制调试信息：和重新连接同一套样式，放在框外面 -->
                        <Button Content="复制调试信息"
                                Click="OnCopyStatus"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Margin="0,0,0,14" />

                        <!-- ⑤ 配置文件夹：输入框 + 选择 -->
                        <TextBlock Text="配置文件夹" Style="{StaticResource SectionLabel}" />
                        <Grid Margin="0,0,0,10"
                              AutomationProperties.AutomationId="SettingsConfigFolder">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ConfigDirectory, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontSize="11"
                                     VerticalContentAlignment="Center"
                                     ToolTip="当前使用的 EqualizerAPO config 文件夹" />
                            <Button Grid.Column="1"
                                    Content="选择文件夹"
                                    Click="OnPickConfigFolder"
                                    Margin="8,0,0,0" />
                        </Grid>

                        <!-- 权限警告与诊断 -->
                        <Button Content="检查配置权限"
                                Click="OnCheckPermission"
                                Margin="0,0,0,8"
                                Visibility="{Binding HasConfigWarning, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding ConfigWarning}"
                                   FontSize="11"
                                   Foreground="#FFE85A5A"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding HasConfigWarning, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding ApoWarning}"
                                   FontSize="11"
                                   Foreground="#FFD08A2B"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding HasApoWarning, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============ 2. 常规设置 ============ -->
            <Border Grid.Column="1" Style="{StaticResource DashboardCard}" Margin="7,0">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE713;"
                                       FontSize="16"
                                       Foreground="#FF4CC2FF"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="常规设置"
                                       Style="{StaticResource PanelTitle}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Height="1" Background="#FF2E2E2E" Margin="0,14,0,14" />

                        <TextBlock Text="配置保存" Style="{StaticResource SectionLabel}" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="导出设置" Click="OnExportSettings"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Margin="0,0,4,0" />
                            <Button Grid.Column="1" Content="导入设置" Click="OnImportSettings"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Margin="4,0,0,0" />
                        </Grid>

                        <Border Height="1" Background="#FF2E2E2E" Margin="0,0,0,14" />

                        <TextBlock Text="独立模式" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:ToggleSwitch x:Name="IndependentModeSwitch"
                                             Checked="OnIndependentModeChecked"
                                             Unchecked="OnIndependentModeUnchecked" />
                            <TextBlock Text="独立模式"
                                       FontSize="12"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="IndependentModeHint"
                                   Style="{StaticResource Hint}"
                                   Text="打开后不控制 Peace，不使用 Peace 也可以打开。"
                                   Margin="0,0,0,14" />

                        <Border Height="1" Background="#FF2E2E2E" Margin="0,0,0,14" />

                        <TextBlock Text="开机自启" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:ToggleSwitch x:Name="AutoStartSwitch"
                                             Checked="OnAutoStartChecked"
                                             Unchecked="OnAutoStartUnchecked" />
                            <TextBlock Text="开机时自动启动"
                                       FontSize="12"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:ToggleSwitch x:Name="ShowOnStartSwitch"
                                             Checked="OnShowOnStartChecked"
                                             Unchecked="OnShowOnStartUnchecked" />
                            <TextBlock Text="启动时显示界面"
                                       FontSize="12"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Height="1" Background="#FF2E2E2E" Margin="0,14,0,14" />

                        <!-- 消息弹窗：软件不在前台时才弹，曲线从屏幕顶部滑下来 -->
                        <TextBlock Text="消息弹窗" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <ui:ToggleSwitch x:Name="SwitchOsdSwitch"
                                             Checked="OnSwitchOsdChecked"
                                             Unchecked="OnSwitchOsdUnchecked" />
                            <TextBlock Text="切换组合时显示曲线通知"
                                       FontSize="12"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Height="1" Background="#FF2E2E2E" Margin="0,14,0,14" />

                        <!-- 退出行为：这里一改就记住，之后关窗口不再问 -->
                        <TextBlock Text="退出行为" Style="{StaticResource SectionLabel}" />
                        <RadioButton x:Name="CloseExitRadio"
                                     GroupName="CloseBehavior"
                                     Margin="0,0,0,10"
                                     Checked="OnCloseExitChecked">
                            <TextBlock Text="退出软件" FontSize="12" />
                        </RadioButton>
                        <RadioButton x:Name="CloseTrayRadio"
                                     GroupName="CloseBehavior"
                                     Checked="OnCloseTrayChecked">
                            <TextBlock Text="最小化到托盘" FontSize="12" />
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============ 3. 关于软件 ============ -->
            <Border Grid.Column="2" Style="{StaticResource DashboardCard}" Margin="7,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE946;"
                                   FontSize="16"
                                   Foreground="#FF4CC2FF"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="关于软件"
                                   Style="{StaticResource PanelTitle}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Height="1" Background="#FF2E2E2E" Margin="0,14,0,14" />

                    <TextBlock Text="版本" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="VersionText"
                               FontSize="20"
                               FontWeight="SemiBold" />

                    <Button x:Name="CheckUpdateButton"
                            Content="检查更新"
                            Click="OnCheckUpdate"
                            Margin="0,12,0,0" />
                    <TextBlock x:Name="UpdateStatusText"
                               Style="{StaticResource Hint}"
                               Margin="0,8,0,0" />

                    <Border Height="1" Background="#FF2E2E2E" Margin="0,20,0,18" />

                    <!-- 作者：只要 LOGO，下面放按钮，不放网址文字 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <!-- B 站小电视 -->
                            <Canvas Width="52" Height="52">
                                <Path Data="M 17,14 L 12,5 M 35,14 L 40,5"
                                      Stroke="#FFFB7299"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round" />
                                <Border Canvas.Left="6"
                                        Canvas.Top="14"
                                        Width="40"
                                        Height="30"
                                        CornerRadius="8"
                                        Background="#FFFB7299" />
                                <Ellipse Canvas.Left="16" Canvas.Top="25" Width="5" Height="7" Fill="White" />
                                <Ellipse Canvas.Left="31" Canvas.Top="25" Width="5" Height="7" Fill="White" />
                            </Canvas>
                            <Button Content="B 站主页" Click="OnOpenBilibili" Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <!-- GitHub 猫头 -->
                            <Viewbox Width="52" Height="52">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                                          Fill="#FFF0F0F0" />
                                </Canvas>
                            </Viewbox>
                            <Button Content="GitHub 主页" Click="OnOpenGitHub" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
