<Window x:Class="PeaceWpf.ProcessPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择要绑定的窗口"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True">

    <!-- 半透明黑罩铺满整个虚拟屏幕；蓝框画在罩子上面，压暗的只有目标以外的部分。 -->
    <Grid x:Name="Root" Background="#8C000000">
        <Canvas x:Name="FrameLayer" IsHitTestVisible="False">
            <Rectangle x:Name="Highlight"
                       Visibility="Collapsed"
                       Stroke="#FF4CC2FF"
                       StrokeThickness="3"
                       RadiusX="3"
                       RadiusY="3">
                <Rectangle.Effect>
                    <DropShadowEffect Color="#FF4CC2FF" BlurRadius="14" ShadowDepth="0" Opacity="0.9" />
                </Rectangle.Effect>
            </Rectangle>
        </Canvas>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,28,0,0"
                Padding="20,12"
                CornerRadius="10"
                Background="#E61A1A1A"
                BorderBrush="#554CC2FF"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="点击左键 · 绑定鼠标下的窗口"
                           FontSize="15"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="右键或 Esc 取消"
                           FontSize="11"
                           Opacity="0.6"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="TargetText"
                           Text="正在找窗口…"
                           FontSize="12"
                           Opacity="0.85"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="560" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
