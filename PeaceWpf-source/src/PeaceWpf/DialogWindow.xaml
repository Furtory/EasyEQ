<Window x:Class="PeaceWpf.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="450"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- 外面留 18 的边给阴影；圆角靠 Border 画，Win10 / Win11 都是一个样子 -->
    <Border Margin="18"
            CornerRadius="12"
            Background="#FF1A1A1A"
            BorderBrush="#33FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.85" Color="Black" />
        </Border.Effect>

        <StackPanel Margin="22,18,22,18">
            <TextBlock x:Name="TitleText"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="White" />

            <TextBlock x:Name="MessageText"
                       Margin="0,10,0,0"
                       FontSize="12.5"
                       LineHeight="19"
                       Foreground="White"
                       TextWrapping="Wrap" />

            <StackPanel x:Name="ButtonRow"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0" />
        </StackPanel>
    </Border>
</Window>
