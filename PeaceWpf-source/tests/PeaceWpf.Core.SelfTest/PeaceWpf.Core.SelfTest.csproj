<Project Sdk="Microsoft.NET.Sdk">
  <!--
    不依赖测试框架的自测程序：这台机器上只有离线包缓存，没有 xunit。
    用控制台断言跑核心逻辑（点模型、草稿、撤回、滤波器表），失败时返回非 0。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PeaceWpf.Core.SelfTest</RootNamespace>
    <AssemblyName>PeaceWpf.Core.SelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PeaceWpf.Core\PeaceWpf.Core.csproj" />
  </ItemGroup>
</Project>
