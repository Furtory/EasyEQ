<ui:FluentWindow x:Class="PeaceWpf.CalibrationTargetWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="自动EQ · 校准到哪条曲线"
                 Width="500"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24">
        <TextBlock Text="校准到哪条曲线？"
                   FontSize="20"
                   FontWeight="SemiBold" />
        <TextBlock Text="接下来会从 20 Hz 扫到 20 kHz，用麦克风听回来，再算出要补的 EQ。选之前先把麦克风放好。"
                   FontSize="12"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,6,0,18" />

        <!-- 和教程选择窗口同一套排布：两张卡并排居中，底部按钮跟卡片一样宽 -->
        <Grid HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <!-- 平直曲线：一条水平线，表示每个频率一样响 -->
                <Button x:Name="FlatButton"
                        Style="{StaticResource CourseCard}"
                        AutomationProperties.AutomationId="CalibrateFlatButton"
                        ToolTip="让每个频率听起来一样响。音箱、房间，或者想先听没有染色的声音，选这个。"
                        Click="OnFlat">
                    <StackPanel Margin="16" VerticalAlignment="Center">
                        <Border Width="104"
                                Height="104"
                                CornerRadius="52"
                                HorizontalAlignment="Center"
                                Background="#141F6FEB"
                                BorderBrush="#334CC2FF"
                                BorderThickness="1">
                            <Viewbox Width="78" Height="78">
                                <Canvas Width="100" Height="100">
                                    <!-- 频率轴 -->
                                    <Line X1="10" Y1="74" X2="90" Y2="74"
                                          Stroke="#33FFFFFF"
                                          StrokeThickness="1" />
                                    <!-- 平直响应：每个频率都在同一高度 -->
                                    <Path Data="M 10,50 L 90,50"
                                          Stroke="#FF4CC2FF"
                                          StrokeThickness="5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Ellipse Canvas.Left="5" Canvas.Top="45" Width="10" Height="10"
                                             Fill="White" Stroke="#FF1A1A1A" StrokeThickness="2.5" />
                                    <Ellipse Canvas.Left="85" Canvas.Top="45" Width="10" Height="10"
                                             Fill="White" Stroke="#FF1A1A1A" StrokeThickness="2.5" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <TextBlock Text="平直曲线"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0" />
                        <TextBlock Text="把每个频率拉到一样响。音箱、房间校准用这个。"
                                   FontSize="11"
                                   Opacity="0.65"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Button>

                <!-- 哈曼曲线：低频抬起，中高音有起伏 -->
                <Button x:Name="HarmanButton"
                        Style="{StaticResource CourseCard}"
                        Margin="16,0,0,0"
                        AutomationProperties.AutomationId="CalibrateHarmanButton"
                        ToolTip="入耳式耳机常用的目标曲线：低频多约 6 分贝，中高音有些起伏。内置的是简化版。"
                        Click="OnHarman">
                    <StackPanel Margin="16" VerticalAlignment="Center">
                        <Border Width="104"
                                Height="104"
                                CornerRadius="52"
                                HorizontalAlignment="Center"
                                Background="#141F6FEB"
                                BorderBrush="#334CC2FF"
                                BorderThickness="1">
                            <Viewbox Width="78" Height="78">
                                <Canvas Width="100" Height="100">
                                    <!-- 频率轴 -->
                                    <Line X1="10" Y1="74" X2="90" Y2="74"
                                          Stroke="#33FFFFFF"
                                          StrokeThickness="1" />
                                    <!-- 曲线下方的淡填充，强调低频抬起来 -->
                                    <Path Data="M 10,40 C 18,39 22,43 30,46 C 38,49 42,52 48,51 C 54,50 58,42 62,45 C 66,48 68,56 72,53 C 76,50 80,51 90,51 L 90,74 L 10,74 Z"
                                          Fill="#334CC2FF" />
                                    <!-- 哈曼目标：低频高、中频平、2–3k 小峰、5k 微凹 -->
                                    <Path Data="M 10,40 C 18,39 22,43 30,46 C 38,49 42,52 48,51 C 54,50 58,42 62,45 C 66,48 68,56 72,53 C 76,50 80,51 90,51"
                                          Stroke="#FF4CC2FF"
                                          StrokeThickness="5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                    <Ellipse Canvas.Left="5" Canvas.Top="35" Width="10" Height="10"
                                             Fill="White" Stroke="#FF1A1A1A" StrokeThickness="2.5" />
                                    <Ellipse Canvas.Left="85" Canvas.Top="46" Width="10" Height="10"
                                             Fill="White" Stroke="#FF1A1A1A" StrokeThickness="2.5" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <TextBlock Text="哈曼曲线"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0" />
                        <TextBlock Text="入耳式耳机的目标：低频多一些，中高音有点起伏。"
                                   FontSize="11"
                                   Opacity="0.65"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button Grid.Row="1"
                    Content="取消"
                    AutomationProperties.AutomationId="CalibrateCancelButton"
                    Click="OnCancel"
                    HorizontalAlignment="Stretch"
                    Margin="0,16,0,0"
                    Padding="16,6"
                    IsCancel="True" />

        </Grid>

        <!-- 这条说明放在卡片区外面：它不参与宽度计算，否则长文本会把上面的
             Grid 撑宽，取消按钮就跟两张卡片对不齐了 -->
        <TextBlock x:Name="HintText"
                   Text="内置的哈曼曲线是公开数据的一份平滑近似，不是官方原始测量，也不区分入耳式和头戴。"
                   FontSize="11"
                   Opacity="0.55"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="394"
                   HorizontalAlignment="Center"
                   Margin="0,14,0,0" />
    </StackPanel>
</ui:FluentWindow>
