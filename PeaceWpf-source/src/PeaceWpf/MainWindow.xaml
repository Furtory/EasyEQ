<ui:FluentWindow x:Class="PeaceWpf.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:ctrl="clr-namespace:PeaceWpf.Controls"
                 xmlns:conv="clr-namespace:PeaceWpf.Converters"
                 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                 Title="电竞调音台"
                 Icon="Assets/EasyEQ.ico"
                 Width="1280"
                 Height="720"
                 MinWidth="1120"
                 MinHeight="560"
                 WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ctrl:LevelDbTextConverter x:Key="LevelDbText" />
        <ctrl:LevelDbBrushConverter x:Key="LevelDbBrush" />

        <!-- 风味下拉里每一项的字体颜色，和曲线手柄共用 TonePalette 那一份 -->
        <conv:FlavorBrushConverter x:Key="FlavorBrush" />

        <!-- 风味图标：Lucide 的几何路径，和曲线上的图标共用 FlavorIcons 那一份 -->
        <conv:FlavorIconConverter x:Key="FlavorIcon" />

        <!-- 拟物推子：凹槽是压进去的，拇指是一块有厚度和投影的金属片 -->
        <Style x:Key="FaderTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FaderThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="34" Height="22" Background="Transparent">
                            <!-- 落在凹槽里的影子 -->
                            <Border CornerRadius="6"
                                    Background="#99000000"
                                    Margin="3,4,3,0"
                                    VerticalAlignment="Stretch" />
                            <!-- 金属推子：上亮下暗再回亮，模拟一道横向圆弧高光 -->
                            <Border CornerRadius="5"
                                    BorderThickness="1"
                                    BorderBrush="#E6000000">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFDFDFD" Offset="0" />
                                        <GradientStop Color="#FFE4E4E4" Offset="0.26" />
                                        <GradientStop Color="#FFA6A6A6" Offset="0.52" />
                                        <GradientStop Color="#FFD8D8D8" Offset="0.74" />
                                        <GradientStop Color="#FF8B8B8B" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Border Height="2"
                                            Margin="7,0"
                                            CornerRadius="1"
                                            Background="#8C000000"
                                            VerticalAlignment="Center" />
                                    <Border Height="1"
                                            Margin="7,4,7,0"
                                            CornerRadius="1"
                                            Background="#66FFFFFF"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FaderSlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <!-- 凹槽本体 + 左侧内高光，做出下陷的厚度 -->
                            <!-- 限宽到槽宽：反光条是按 Left 对齐的，Grid 不限宽就会贴到整列最左边，成一条贯穿的竖线 -->
                            <Grid Margin="0,2,0,2"
                                  Width="12"
                                  HorizontalAlignment="Center">
                                <Border Width="12"
                                        HorizontalAlignment="Center"
                                        CornerRadius="6"
                                        BorderThickness="1"
                                        BorderBrush="#2EFFFFFF">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FF050505" Offset="0" />
                                            <GradientStop Color="#FF1E1E1E" Offset="0.16" />
                                            <GradientStop Color="#FF3C3C3C" Offset="0.38" />
                                            <GradientStop Color="#FF141414" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <!-- 槽底那一点点反光 -->
                                <Border Width="3"
                                        Margin="3,3,0,3"
                                        HorizontalAlignment="Left"
                                        CornerRadius="1.5"
                                        Background="#1FFFFFFF" />
                            </Grid>

                            <Track x:Name="PART_Track" Orientation="Vertical" Margin="0,8,0,8">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource FaderTrackButton}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FaderThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource FaderTrackButton}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 横向白色滚轮：凹槽里一只带竖向刻纹的白轮子 -->
        <Style x:Key="WheelThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="34" Height="26" Background="Transparent">
                            <Border CornerRadius="9" Background="#8F000000" Margin="2,3,2,-1" />
                            <Border CornerRadius="8" BorderThickness="1" BorderBrush="#B3000000">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                                        <GradientStop Color="#FFF4F4F4" Offset="0.18" />
                                        <GradientStop Color="#FFC8C8C8" Offset="0.52" />
                                        <GradientStop Color="#FFF1F1F1" Offset="0.79" />
                                        <GradientStop Color="#FFAEAEAE" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Margin="1">
                                    <!-- 顶上一道高光，读成圆弧 -->
                                    <Border Height="3"
                                            VerticalAlignment="Top"
                                            Margin="4,1,4,0"
                                            CornerRadius="1.5"
                                            Background="#B3FFFFFF" />
                                    <!-- 滚轮上的刻纹 -->
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Stretch"
                                                Margin="0,5,0,5">
                                        <Border Width="1" Margin="3,0" Background="#42000000" />
                                        <Border Width="1" Margin="3,0" Background="#42000000" />
                                        <Border Width="1" Margin="3,0" Background="#42000000" />
                                        <Border Width="1" Margin="3,0" Background="#42000000" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WheelSlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" VerticalAlignment="Center" Height="26">
                            <Grid Margin="0,4,0,0">
                                <Border Height="10"
                                        VerticalAlignment="Center"
                                        CornerRadius="5"
                                        BorderThickness="1"
                                        BorderBrush="#C7000000">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF050505" Offset="0" />
                                            <GradientStop Color="#FF3A3A3A" Offset="0.46" />
                                            <GradientStop Color="#FF121212" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border Height="2"
                                        Margin="4,0,4,2"
                                        VerticalAlignment="Center"
                                        CornerRadius="1"
                                        Background="#1FFFFFFF" />
                            </Grid>

                            <Track x:Name="PART_Track" Orientation="Horizontal" Margin="14,0,14,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource FaderTrackButton}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource WheelThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource FaderTrackButton}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 保存 / 取消：实心圆角，绿一档红一档，防止在灰底上看不出重点 -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="6" Background="{TemplateBinding Background}" />
                            <Border x:Name="Overlay" CornerRadius="6" Background="Transparent" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#FF1E8E4A" />
        </Style>

        <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#FFB3352D" />
        </Style>

        <!-- 模式按钮：圆角片。没选中的时候比主窗口底色浅一档，选中的时候整块蓝 -->
        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Background" Value="#FF2C2C2C" />
            <Setter Property="BorderBrush" Value="#FF3F3F3F" />
            <Setter Property="Foreground" Value="#FFDCDCDC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- 底色和描边跟着 Background / BorderBrush 走，选中时由 DataTrigger 换成蓝 -->
                            <Border CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True" />

                            <!-- 悬停/按下的亮光单独一层，叠上去不盖掉底色，蓝色选中时也照样提亮 -->
                            <Border x:Name="Overlay"
                                    CornerRadius="8"
                                    Background="Transparent" />

                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#2BFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeButtonMain" TargetType="Button" BasedOn="{StaticResource ModeButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMainLayerMode}" Value="True">
                    <Setter Property="Background" Value="#FF1F6FEB" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="#FF4CC2FF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModeButtonBass" TargetType="Button" BasedOn="{StaticResource ModeButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBassLayerMode}" Value="True">
                    <Setter Property="Background" Value="#FF1F6FEB" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="#FF4CC2FF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 预设下拉里的一行：左侧是文件名，右侧那条竖向的“⋮⋮”是拖动排序的抓手 -->
        <Style x:Key="PresetComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,3,3,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}" />

                                <Border Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Padding="4,0,2,0"
                                        Background="Transparent"
                                        Cursor="SizeNS"
                                        ToolTip="按住右侧 ⋮⋮ 上下拖动，可以调整预设的前后顺序">
                                    <TextBlock Text="⋮⋮"
                                               FontSize="11"
                                               Opacity="0.45"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#33808080" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#552F6FD0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <!-- 事件挂在条目自己身上：下拉弹层有自己的鼠标捕获，挂在 ComboBox 上要靠事件冒泡跨窗口，
                 这里不赌那一层，条目被点到就一定能收到。 -->
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnPresetGripMouseDown" />
            <EventSetter Event="PreviewMouseMove" Handler="OnPresetMouseMove" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnPresetMouseUp" />
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnPresetItemRightButtonDown" />
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="OnPresetItemRightButtonUp" />
        </Style>

        <!-- 标题栏右上角那四个按钮：符号一律纯白，不跟主题的前景灰走。
             模板自己画底，免得默认 Button 模板在深色背景上给出一块浅灰底。 -->
        <ControlTemplate x:Key="CaptionButtonTemplate" TargetType="Button">
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 风味下拉：列表一律向上弹。它固定在底部工具条上，向下会顶到屏幕外，
             教程的模拟列表也照这个方向做，两边才对得上。 -->
        <Style x:Key="FlavorCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFDCDCDC" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Left"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="#FF141414"
                                                BorderBrush="#334CC2FF"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                HorizontalAlignment="Stretch">
                                            <Grid>
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <TextBlock Text="&#xE70E;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="9"
                                                           Foreground="#99FFFFFF"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#664CC2FF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Top"
                                   StaysOpen="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#FF1C1C1C"
                                        BorderBrush="#994CC2FF"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="2"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>

                            <!-- 没选目标时的占位：问号 + 未选择；右边留出箭头的位置 -->
                            <StackPanel x:Name="Placeholder"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="9,0,24,0"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed">
                                <Border Width="15"
                                        Height="15"
                                        CornerRadius="7.5"
                                        BorderBrush="#66FFFFFF"
                                        BorderThickness="1"
                                        Margin="0,0,6,0">
                                    <TextBlock Text="?"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#99FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="未选择"
                                           FontSize="12"
                                           Foreground="#99FFFFFF"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource CaptionButtonTemplate}" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    </Window.InputBindings>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏：应用名 + 设置/最小化/最大化/关闭 -->
        <Grid x:Name="TitleBarRow"
              Grid.Row="0"
              Background="Transparent"
              MouseLeftButtonDown="OnTitleBarMouseDown">
            <!-- 左上角这枚小标同时是启动动画的落点：大 LOGO 从正中飞到这里停住，
                 遮罩淡出后它就是标题栏里的常驻图标，交接看不出断点。 -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0">
                <Image x:Name="TitleLogo"
                       Width="22"
                       Height="22"
                       Source="Assets/logo.png"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="TitleLogoText"
                           Text="电竞调音台"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           FontSize="14"
                           FontWeight="SemiBold" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,2,6,0">
                <Button Style="{StaticResource CaptionButton}"
                        Content="教程"
                        Width="48"
                        FontSize="12"
                        AutomationProperties.AutomationId="TutorialButton"
                        ToolTip="打开教程：手把手带你走一遍，分基础课和进阶课"
                        Click="OnOpenTutorial" />
                <Button Style="{StaticResource CaptionButton}"
                        Content="⚙"
                        AutomationProperties.AutomationId="SettingsButton"
                        ToolTip="打开设置：查看状态、处理报错"
                        Click="OnOpenSettings" />
                <Button Style="{StaticResource CaptionButton}"
                        Content="—"
                        ToolTip="最小化"
                        Click="OnMinimize" />
                <Button Style="{StaticResource CaptionButton}"
                        Content="□"
                        ToolTip="最大化"
                        Click="OnMaximize" />
                <Button Style="{StaticResource CaptionButton}"
                        Content="✕"
                        ToolTip="关闭"
                        Click="OnClose" />
            </StackPanel>
        </Grid>

        <!-- 模式按钮、两层预设下拉、叠加开关；预设EQ / 自动EQ 靠最右 -->
        <Grid Grid.Row="1" Margin="16,10,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="TopBarLeft"
                        Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="左右"
                        AutomationProperties.AutomationId="ModeMain"
                        Style="{StaticResource ModeButtonMain}"
                        Command="{Binding ToggleMainLayerCommand}"
                        ToolTip="点这里编辑左右声道的曲线（主曲线）" />
                <ComboBox Width="168"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          FontSize="12"
                          AutomationProperties.AutomationId="MainPresetCombo"
                          ItemsSource="{Binding AvailablePresets}"
                          ItemContainerStyle="{StaticResource PresetComboItem}"
                          SelectedItem="{Binding SelectedMainPreset, Mode=TwoWay}"
                          DropDownClosed="OnPresetDropDownClosed"
                          ToolTip="左右声道用哪套预设；右键可改名、复制、删除；按住右侧 ⋮⋮ 可拖动排序">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource PresetName}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="重命名…" Click="OnPresetMenuRename" />
                            <MenuItem Header="复制" Click="OnPresetMenuCopy" />
                            <MenuItem Header="删除…" Click="OnPresetMenuDelete" />
                        </ContextMenu>
                    </ComboBox.ContextMenu>
                </ComboBox>

                <Button Content="+"
                        AutomationProperties.AutomationId="MainPresetAddButton"
                        Width="30"
                        Height="28"
                        Padding="0"
                        FontSize="15"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0"
                        IsEnabled="{Binding IsApoFound}"
                        Click="OnCreateMainPreset"
                        ToolTip="新建一个左右预设：曲线从平直开始，建完直接切过去" />

                <Button Content="低音"
                        AutomationProperties.AutomationId="ModeBass"
                        Style="{StaticResource ModeButtonBass}"
                        Command="{Binding ToggleBassLayerCommand}"
                        ToolTip="点这里编辑低音层的曲线" />
                <ComboBox Width="168"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          FontSize="12"
                          AutomationProperties.AutomationId="BassPresetCombo"
                          ItemsSource="{Binding AvailablePresets}"
                          ItemContainerStyle="{StaticResource PresetComboItem}"
                          SelectedItem="{Binding SelectedBassPreset, Mode=TwoWay}"
                          DropDownClosed="OnPresetDropDownClosed"
                          ToolTip="低音层用哪套预设；右键可改名、复制、删除；按住右侧 ⋮⋮ 可拖动排序">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource PresetName}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="重命名…" Click="OnPresetMenuRename" />
                            <MenuItem Header="复制" Click="OnPresetMenuCopy" />
                            <MenuItem Header="删除…" Click="OnPresetMenuDelete" />
                        </ContextMenu>
                    </ComboBox.ContextMenu>
                </ComboBox>

                <Button Content="+"
                        AutomationProperties.AutomationId="BassPresetAddButton"
                        Width="30"
                        Height="28"
                        Padding="0"
                        FontSize="15"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0"
                        IsEnabled="{Binding IsApoFound}"
                        Click="OnCreateBassPreset"
                        ToolTip="新建一个低音预设：曲线从平直开始，建完直接切过去" />

                <CheckBox Content="叠加低音修正"
                          AutomationProperties.AutomationId="BassLayerSwitch"
                          IsChecked="{Binding IsBassLayerEnabled, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Padding="0"
                          Margin="0,0,12,0"
                          FontSize="12"
                          ToolTip="决定退出编辑后低音曲线叠不叠加进左右曲线。编辑时先按当前层试听：编低音会叠上左右，编左右不叠低音；退出编辑后才按这里的勾选生效。" />

                <CheckBox Content="无延迟防爆音"
                          AutomationProperties.AutomationId="PeakGuardSwitch"
                          IsChecked="{Binding IsPeakGuardEnabled, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Padding="0"
                          Margin="0,0,12,0"
                          FontSize="12"
                          ToolTip="在声音链路最后加一个零延迟削峰器：只在音量快要破音时削掉峰值，平时一个采样都不动。EQ 抬得再多也不会整体变小，代价是超出的那一点会变成谐波。" />

                <CheckBox Content="频谱显示"
                          AutomationProperties.AutomationId="SpectrumSwitch"
                          IsChecked="{Binding IsSpectrumEnabled, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Padding="0"
                          FontSize="12"
                          ToolTip="在曲线下方显示正在播放声音的频率分布；关掉能省一点电脑资源" />
            </StackPanel>

            <StackPanel x:Name="TopBarRight"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="SweepSmoothButton"
                        Content="平滑 关"
                        Padding="6,4"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Click="OnSweepSmoothNext"
                        ToolTip="点一次提高一档：关 → 1/24 → 1/12 → 1/6 倍频程。只影响画出来的样子，尖峰太窄会被磨平，判断驻波请看关档或合并线" />

                <Border Background="#1E1E1E"
                        BorderBrush="#33808080"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="SweepSecondsBox"
                                 Width="30"
                                 Text="10"
                                 MaxLength="2"
                                 TextAlignment="Right"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="4,3,0,3"
                                 VerticalContentAlignment="Center"
                                 LostFocus="OnSweepSecondsCommit"
                                 KeyDown="OnSweepSecondsKeyDown"
                                 ToolTip="扫频时长（秒），2–99。越长低频越准，等待也越久" />
                        <TextBlock Text="秒"
                                   VerticalAlignment="Center"
                                   Margin="2,0,6,0"
                                   Foreground="#AAFFFFFF" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Vertical"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button Content="▲"
                            Width="16"
                            Height="11"
                            FontSize="6"
                            Padding="0"
                            Click="OnSweepSecondsUp"
                            ToolTip="加 1 秒" />
                    <Button Content="▼"
                            Width="16"
                            Height="11"
                            FontSize="6"
                            Padding="0"
                            Click="OnSweepSecondsDown"
                            ToolTip="减 1 秒" />
                </StackPanel>

                <Button Content="扫频"
                        AutomationProperties.AutomationId="SweepButton"
                        Click="OnPlaySweep"
                        MouseDown="OnSweepMiddleClick"
                        MouseRightButtonDown="OnSweepClear"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        ToolTip="放一遍扫频（20 Hz 一路升到 20 kHz），同时录一遍并画成绿色曲线，最多留 5 条，旧的变暗。中键把已有的曲线合并（用来分辨驻波），右键清空。听到的就是现在这套 EQ；叠不叠低音看「叠加低音修正」的勾选" />

                <Button Content="预设EQ"
                        AutomationProperties.AutomationId="AutoEqButton"
                        Click="OnOpenAutoEq"
                        Padding="12,6"
                        ToolTip="按耳机型号套用现成的校正曲线（数据来自 AutoEQ 库）" />

                <Button Content="自动EQ"
                        x:Name="AutoCalibrateButton"
                        AutomationProperties.AutomationId="AutoCalibrateButton"
                        Click="OnOpenAutoCalibrate"
                        Padding="12,6"
                        Margin="8,0,0,0"
                        ToolTip="用麦克风实际测一次，测出设备或房间的声音特点，再自动帮你补平" />

                <Button Content="自动切换"
                        AutomationProperties.AutomationId="AutoSwitchButton"
                        Click="OnOpenAutoSwitch"
                        Padding="12,6"
                        Margin="8,0,0,0"
                        ToolTip="把「左右 + 低音 + 叠加开关」存成一组：按热键或切到绑定的进程时自动套用" />
            </StackPanel>
        </Grid>

        <!-- 曲线 + 右侧竖排：增益滑块、电平表 -->
        <Grid Grid.Row="2" Margin="16,10,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ctrl:EqGraphView x:Name="Graph"
                              AutomationProperties.AutomationId="EqGraph"
                              Points="{Binding Points}"
                              ReferencePoints="{Binding ReferencePoints}"
                              GainRange="{Binding GainRangeDb}"
                              PreAmpDb="{Binding GraphPreAmpDb}"
                              IsEditable="{Binding IsEditable}"
                              Spectrum="{Binding Spectrum}"
                              Flavors="{Binding Flavors}"
                              FlavorBrushes="{Binding FlavorBrushes}"
                              SelectedFlavorIndex="{Binding SelectedFlavorIndex}"
                              FlavorHandlesInteractive="{Binding IsFlavorEditable}"
                              BassEditing="{Binding IsBassLayerMode}"
                              BassOverlayEnabled="{Binding IsBassLayerEnabled}"
                              CreatePointRequested="OnCreatePointRequested"
                              PointMovePreview="OnPointMovePreview"
                              PointMoveCommitted="OnPointMoveCommitted"
                              PointDeleteRequested="OnPointDeleteRequested"
                              PointResetRequested="OnPointResetRequested"
                              QualityChanged="OnQualityChanged"
                              FlavorSelected="OnFlavorSelected"
                              FlavorFrequencyPreview="OnFlavorFrequencyPreview"
                              FlavorFrequencyCommitted="OnFlavorFrequencyCommitted"
                              FlavorQualityChanged="OnFlavorQualityChanged"
                              FlavorResetRequested="OnFlavorReset" />

            <Grid Grid.Column="1" Width="112" Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="增益"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Opacity="0.7" />
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="电平"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Opacity="0.7" />

                <!-- 滑杆和电平表同处中间一行、同样的上下留白，两端一样齐 -->
                <Slider Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource FaderSlider}"
                        AutomationProperties.AutomationId="PreampSlider"
                        Minimum="-20"
                        Maximum="20"
                        TickFrequency="0.5"
                        IsEnabled="{Binding IsPreampEnabled}"
                        Value="{Binding PreAmpDb, Mode=TwoWay}"
                        PreviewMouseRightButtonDown="OnPreampReset"
                        Margin="0,8,0,8"
                        ToolTip="整体音量（预增益）：拖它整条曲线一起上下平移，形状不变；右键一键回到 0 dB，拖动后按保存或取消" />

                <ctrl:LevelMeter Grid.Row="1"
                                 Grid.Column="1"
                                 LevelDb="{Binding PeakDb}"
                                 Margin="6,8,0,8"
                                 ToolTip="现在声音有多响；满格（0 dB）就可能破音" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           AutomationProperties.AutomationId="PreampValue"
                           Text="{Binding PreAmpDb, StringFormat={}{0:0.0} dB}"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Opacity="0.75" />

                <!-- 电平表底下那格：把条子对应的数值也写出来，满格时好判断离破音还有多少 -->
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           AutomationProperties.AutomationId="LevelValue"
                           Text="{Binding PeakDb, Converter={StaticResource LevelDbText}}"
                           Foreground="{Binding PeakDb, Converter={StaticResource LevelDbBrush}}"
                           HorizontalAlignment="Center"
                           FontSize="10"
                           ToolTip="电平表上的数值，一位小数；静音（−60 dB 以下）写 -∞，到 -6 dB 起变红" />
            </Grid>
        </Grid>

        <!-- 均衡（常驻，拖完即生效） -->
        <Border x:Name="BalanceBar"
                Grid.Row="3"
                Margin="16,0,16,12"
                Padding="12,8"
                CornerRadius="6"
                Background="#10808080">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="160" MaxWidth="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="左声道" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" Opacity="0.75" />
                <Slider Grid.Column="1"
                        Style="{StaticResource WheelSlider}"
                        AutomationProperties.AutomationId="BalanceSlider"
                        HorizontalAlignment="Stretch"
                        Minimum="-1"
                        Maximum="1"
                        TickFrequency="0.05"
                        Value="{Binding Balance, Mode=TwoWay}"
                        PreviewMouseRightButtonDown="OnBalanceReset"
                        ToolTip="左右音量平衡：往哪边拖，哪边就更响，拖动后马上生效；右键一键回到正中间" />
                <TextBlock Grid.Column="2"
                           AutomationProperties.AutomationId="BalanceRightLabel"
                           Text="右声道"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           FontSize="12"
                           Opacity="0.75" />

                <!-- 左边是编辑动作，最右边是保存 / 取消 -->
                <DockPanel Grid.Column="3" Margin="36,0,0,0" VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource SaveButton}"
                                AutomationProperties.AutomationId="SaveButton"
                                Command="{Binding SaveCommand}"
                                Margin="12,0,8,0"
                                ToolTip="保存到两份预设文件并退出编辑，新音效立即生效">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE74E;"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="保存" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CancelButton}"
                                AutomationProperties.AutomationId="CancelButton"
                                Command="{Binding CancelCommand}"
                                ToolTip="放弃这次改动并退出编辑，回到上次保存时的样子">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE711;"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="取消" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 只读态不显示这些编辑动作 -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}">
                        <Button AutomationProperties.AutomationId="UndoButton"
                                Command="{Binding UndoCommand}"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                FontSize="12"
                                IsEnabled="{Binding CanUndo}"
                                ToolTip="撤回上一步（Ctrl+Z），最多能退 50 步">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE7A7;"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="撤回调整" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.AutomationId="RedoButton"
                                Command="{Binding RedoCommand}"
                                Padding="10,4"
                                FontSize="12"
                                IsEnabled="{Binding CanRedo}"
                                ToolTip="重做刚撤回的一步（Ctrl+Y）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE7A6;"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="还原调整" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- 风味：独立叠加层，八条固定推子；只管「左右」那一份配置 -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsFlavorEditable, Converter={StaticResource BoolToVis}}">
                            <Rectangle Width="1" Fill="#33FFFFFF" Margin="10,2" />
                            <TextBlock Text="风味"
                                       FontSize="12"
                                       Opacity="0.75"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"
                                       ToolTip="八种听得出来、但说不出位置的声音类型；叠加在左右曲线上，不写进 .peace 预设。在曲线上拖它们的手柄改频率和增益，滚轮改 Q" />
                            <ComboBox Width="156"
                                      Style="{StaticResource FlavorCombo}"
                                      FontSize="12"
                                      VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="FlavorCombo"
                                      ItemsSource="{Binding FlavorChoices}"
                                      SelectedItem="{Binding SelectedBand, Mode=TwoWay}"
                                      ToolTip="{Binding SelectedBand.Hint}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="{Binding Key, Converter={StaticResource FlavorIcon}}"
                                                          Stroke="{Binding Key, Converter={StaticResource FlavorBrush}}"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="{Binding Label}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Key, Converter={StaticResource FlavorBrush}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- 启动遮罩：纯黑盖住整块界面（跨满四行），LOGO 正中，软件名在它下面。
             启动后 LOGO 缩小飞向左上角，遮罩淡出，控件才露出来。 -->
        <Grid x:Name="SplashLayer"
              Grid.Row="0"
              Grid.RowSpan="4"
              Background="#FF000000"
              Opacity="1">
            <!-- LOGO 严格居中；软件名用 Margin 挂在它下面，不参与居中计算。 -->
            <Grid x:Name="SplashGroup"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Image x:Name="SplashLogo"
                       Width="132"
                       Height="132"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Source="Assets/logo.png"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="SplashScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="SplashShift" X="0" Y="0" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <TextBlock x:Name="SplashTitle"
                           Text="电竞调音台"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,206,0,0"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#FFF5F5F5" />
            </Grid>
        </Grid>

    </Grid>
</ui:FluentWindow>
